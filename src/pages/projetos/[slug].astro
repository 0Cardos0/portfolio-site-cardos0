---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getProjects } from '@lib/projects';
import { projectCategories } from '@config/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const categoryLabel =
  projectCategories.find((c) => c.id === data.category)?.label ?? data.category;

const dateLabel = new Intl.DateTimeFormat('pt-BR', {
  month: 'long',
  year: 'numeric',
}).format(data.date);
---

<BaseLayout title={data.title} description={data.description}>
  <article class="project section">
    <div class="container project-head">
      <a href="/#projetos" class="back-link">&larr; Voltar aos projetos</a>

      <p class="section-tag">{categoryLabel}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>

      <dl class="meta">
        {data.client && (
          <div><dt>Cliente</dt><dd>{data.client}</dd></div>
        )}
        <div><dt>Categoria</dt><dd>{categoryLabel}</dd></div>
        <div><dt>Data</dt><dd>{data.year ?? dateLabel}</dd></div>
        {
          data.tags.length > 0 && (
            <div>
              <dt>Tecnologias</dt>
              <dd>{data.tags.join(', ')}</dd>
            </div>
          )
        }
      </dl>

      {
        data.url && (
          <div class="actions">
            <a class="btn btn-primary" href={data.url} target="_blank" rel="noopener noreferrer">
              Visitar site
            </a>
          </div>
        )
      }
    </div>

    {
      data.thumb && (
        <div class="container" data-reveal="zoom">
          <img
            class="cover"
            src={data.thumb}
            alt={data.thumbAlt ?? `Prévia do site ${data.title}`}
            width={1140}
            height={640}
            decoding="async"
          />
        </div>
      )
    }

    <div class="container prose" data-reveal>
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-head {
    max-width: 760px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--text);
  }

  .project h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: 1.1rem;
    margin-bottom: 28px;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 18px;
    margin: 0 0 28px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .meta dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .meta dd {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
  }

  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 40px;
  }

  .prose {
    max-width: 760px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 1.8em;
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.5em;
  }

  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 1.5em 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text-muted);
    padding-left: 1.2em;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
  }

  .prose :global(code) {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }
</style>
