---
import { site, projectCategories } from '@config/site';
import ProjectCard from '@components/ProjectCard.astro';
import type { Project } from '@lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const { tag, heading, lead } = site.projects;

// Só mostra um filtro se existir pelo menos um projeto naquela categoria.
const usedCategories = new Set<string>(projects.map((p) => p.data.category));
const filters = projectCategories.filter(
  (c) => c.id === 'all' || usedCategories.has(c.id),
);
// A barra só faz sentido com 2+ categorias reais em uso.
const showFilters = usedCategories.size > 1;
---

<section id="projetos" class="section section-alt">
  <div class="container">
    <p class="section-tag" data-reveal>{tag}</p>
    <h2 data-reveal>{heading}</h2>
    <p class="section-lead" data-reveal>{lead}</p>

    {
      showFilters && (
        <div class="filter-bar" id="filter-bar" data-reveal role="group" aria-label="Filtrar projetos">
          {filters.map((cat, i) => (
            <button
              class:list={['filter-btn', { 'is-active': i === 0 }]}
              data-filter={cat.id}
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {cat.label}
            </button>
          ))}
        </div>
      )
    }

    {
      projects.length > 0 ? (
        <div class="projects-grid" id="projects-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-state">
          Nenhum projeto publicado ainda. Adicione um arquivo <code>.md</code> em
          <code>src/content/projetos/</code>.
        </p>
      )
    }
  </div>
</section>

<style>
  .filter-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 32px 0 40px;
  }

  .filter-btn {
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.88rem;
    cursor: pointer;
    transition:
      color var(--transition),
      background var(--transition),
      border-color var(--transition);
  }

  .filter-btn:hover {
    color: var(--text);
  }

  .filter-btn.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .empty-state {
    padding: 32px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .empty-state code {
    color: var(--text);
    font-size: 0.85em;
  }

  @media (max-width: 860px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterBar = document.getElementById('filter-bar');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));

  filterBar?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    filterBar.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.toggle('is-active', b === btn);
      b.setAttribute('aria-pressed', String(b === btn));
    });

    const filter = btn.dataset.filter;
    cards.forEach((card) => {
      const matches = filter === 'all' || card.dataset.category === filter;
      card.classList.toggle('is-hidden', !matches);
    });
  });
</script>
