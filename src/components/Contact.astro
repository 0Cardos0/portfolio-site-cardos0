---
import { site } from '@config/site';
const { tag, heading, lead, links } = site.contact;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<section id="contato" class="section">
  <div class="container contact-inner">
    <p class="section-tag" data-reveal>{tag}</p>
    <h2 data-reveal>{heading}</h2>
    <p class="section-lead" data-reveal>{lead}</p>

    <div class="contact-links" data-reveal>
      {
        links.map((link) =>
          link.plain ? (
            <span class="contact-plain">{link.label}</span>
          ) : (
            <a
              href={link.href}
              class:list={[
                'btn',
                link.primary ? 'btn-primary' : 'btn-ghost',
                link.icon && 'btn-icon-only',
              ]}
              aria-label={link.icon ? link.label : undefined}
              {...isExternal(link.href)
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {}}
            >
              {link.icon === 'whatsapp' ? (
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                </svg>
              ) : (
                link.label
              )}
            </a>
          )
        )
      }
    </div>
  </div>
</section>

<style>
  .contact-inner {
    text-align: center;
  }

  .contact-inner .section-lead {
    margin-inline: auto;
  }

  .contact-links {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
  }

  /* E-mail exibido como texto — selecionável, sem ação de clique. */
  .contact-plain {
    font-weight: 600;
    color: var(--text);
    user-select: all;
    letter-spacing: 0.01em;
  }

  .btn-icon-only {
    padding: 0;
    width: 48px;
    height: 48px;
    justify-content: center;
  }

  .btn-icon-only svg {
    width: 22px;
    height: 22px;
    flex: none;
  }

  /* Pulso constante no botão do WhatsApp (anel + leve batida). */
  @media (prefers-reduced-motion: no-preference) {
    .btn-icon-only {
      animation:
        wa-ring 2.2s ease-out infinite,
        wa-beat 2.2s ease-in-out infinite;
    }

    /* No hover/foco, para o pulso e devolve o realce normal do botão. */
    .btn-icon-only:hover,
    .btn-icon-only:focus-visible {
      animation: none;
    }
  }

  @keyframes wa-ring {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent);
    }
    70% {
      box-shadow: 0 0 0 14px color-mix(in srgb, var(--accent) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
    }
  }

  @keyframes wa-beat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }
</style>
